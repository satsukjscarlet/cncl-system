APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CNCL_CERT_MAIL_CC_DVKH=
CNCL_CERT_MAIL_CC_PTN=
CNCL_CERT_MAIL_CC_EXTRA=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SMARTCA_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
SMARTCA_SIGNATURE_BASE_URL=
SMARTCA_CLIENT_ID=
SMARTCA_CLIENT_SECRET=
SMARTCA_SERIAL_NUMBER=
SMARTCA_USER_ID_FIELD=smartca_user_id
SMARTCA_DEFAULT_USER_ID=
SMARTCA_SIGN_TYPE=hash
SMARTCA_REQUIRE_SIGNED_PDF=false
SMARTCA_PADES_ENABLED=false
SMARTCA_PADES_PROVIDER=vnpt
SMARTCA_PADES_HASH_ENCODING=hex
SMARTCA_PYTHON_BIN=python
SMARTCA_TIMEOUT=30
