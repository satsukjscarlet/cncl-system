APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CNCL_CERT_MAIL_CC_DVKH=
CNCL_CERT_MAIL_CC_PTN=
CNCL_CERT_MAIL_CC_EXTRA=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# VNPT SmartCA
# SMARTCA_ENV chon bo cau hinh dang su dung: test hoac production.
# - test: dung de thu nghiem, khong anh huong cau hinh chinh thuc.
# - production: dung key/chung thu SmartCA chinh thuc de ky phieu that.
# Sau khi sua cac dong SMARTCA_* hay chay: php artisan config:clear
# -----------------------------------------------------------------------------
SMARTCA_ENV=test

# Cau hinh SmartCA TEST - giu lai de can co the quay ve thu nghiem.
# BASE_URL: gateway SmartCA test. SIGNATURE_BASE_URL co the de trong de he thong tu suy ra /rest/v2/signature.
# CLIENT_ID / CLIENT_SECRET: cap key test do VNPT cap.
# SERIAL_NUMBER: so serial chung thu test. DEFAULT_USER_ID: CCCD/MST/SĐT SmartCA test.
SMARTCA_TEST_BASE_URL=https://rmgateway.vnptit.vn/sca/sp769
SMARTCA_TEST_SIGNATURE_BASE_URL=
SMARTCA_TEST_CLIENT_ID=
SMARTCA_TEST_CLIENT_SECRET=
SMARTCA_TEST_SERIAL_NUMBER=
SMARTCA_TEST_DEFAULT_USER_ID=

# Cau hinh SmartCA PRODUCTION - sua cac dong ben duoi khi thay key/chung thu chinh thuc.
# Khi SMARTCA_ENV=production, he thong se uu tien dung nhom SMARTCA_PRODUCTION_* nay.
# Neu VNPT cap endpoint production khac endpoint test, thay SMARTCA_PRODUCTION_BASE_URL tai day.
SMARTCA_PRODUCTION_BASE_URL=https://gwsca.vnpt.vn/sca/sp769
SMARTCA_PRODUCTION_SIGNATURE_BASE_URL=
SMARTCA_PRODUCTION_CLIENT_ID=
SMARTCA_PRODUCTION_CLIENT_SECRET=
SMARTCA_PRODUCTION_SERIAL_NUMBER=
SMARTCA_PRODUCTION_DEFAULT_USER_ID=

# Fallback/legacy: giu de tuong thich code va du lieu cu. Khong can sua neu da dung TEST/PRODUCTION o tren.
# Neu mot bien theo moi truong bi bo trong, he thong se fallback ve cac bien legacy nay.
SMARTCA_BASE_URL=
SMARTCA_SIGNATURE_BASE_URL=
SMARTCA_CLIENT_ID=
SMARTCA_CLIENT_SECRET=
SMARTCA_SERIAL_NUMBER=
SMARTCA_DEFAULT_USER_ID=

# Truong tren bang users dung lam user_id SmartCA cua nguoi ky. Mac dinh la smartca_user_id.
SMARTCA_USER_ID_FIELD=smartca_user_id

# Che do ky hien tai: hash. PADES_ENABLED=true de he thong goi calculateHash/signExternal va luu PDF da ky.
SMARTCA_SIGN_TYPE=hash
SMARTCA_REQUIRE_SIGNED_PDF=false
SMARTCA_PADES_ENABLED=false
SMARTCA_PADES_PROVIDER=vnpt
SMARTCA_PADES_HASH_ENCODING=hex

# Duong dan Python chi dung neu chay helper PAdES noi bo. Voi provider=vnpt co the khong can dung den.
SMARTCA_PYTHON_BIN=python

# TIMEOUT: thoi gian cho API SmartCA. PENDING_TTL_MINUTES: thoi gian app SmartCA cho nguoi ky xac nhan.
SMARTCA_TIMEOUT=30
SMARTCA_PENDING_TTL_MINUTES=5
